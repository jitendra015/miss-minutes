# Add the real value only in Vercel's environment-variable settings.
# Never put a real API key in this file or commit it to GitHub.
OPENAI_API_KEY=your_key_here
# Optional: leave unset to use the default model in the server function.
OPENAI_MODEL=gpt-5.6-luna
# Optional: the feminine-sounding cloud voice used for spoken replies.
OPENAI_TTS_VOICE=shimmer
