# Add the real value only in Vercel's environment-variable settings.
# Never put a real API key in this file or commit it to GitHub.
GROQ_API_KEY=your_key_here
# Optional: leave unset to use the default free-tier chat model.
GROQ_MODEL=llama-3.1-8b-instant
# Optional: feminine English voice for spoken replies.
GROQ_TTS_VOICE=hannah
